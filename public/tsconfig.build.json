{
  "extends": "./tsconfig.check.json",
  "compilerOptions": {
    // project:
    "rootDir": "${configDir}/src", // build only src folder

    // emit:
    "noEmit": false,
    "outDir": "${configDir}/dist",
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true
  },
  "include": ["${configDir}/src"], // build only src folder

  // exclude from build dependencies, tests and compilation result
  "exclude": [
    "**/node_modules",
    "${configDir}/dist",

    // IMPORTANT: brackets not supported, so add each test pattern manually
    "./src/**/*.test.",
    "./src/**/*.spec."
  ]
}
